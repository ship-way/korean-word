#fill #flugin .room:nth-child(3) .box div div{ margin-top: 15px; }
#fill #flugin .room:nth-child(3) .box div div span{ width: 50px; height: 30px; margin: 0 5px; line-height: 30px; }
#fill #flugin .room:nth-child(3) .up{ background: #c33; }
#fill #flugin .room:nth-child(3) .down{ background: #33c; }

/* SEVEN */
#fill .hamburger{ position: absolute; right: 18px; top: 16px; z-index: 10; }
#fill .hamburger .line{ width: 45px; height: 5px; background-color: #97e8d9; display: block; margin: 7px auto; transition: all 0.3s ease-in-out; }

#fill #hamburger-7.is-active .line:nth-child(1){ width: 60%; }
#fill #hamburger-7.is-active .line:nth-child(2){ width: 80%; }
#fill #hamburger-7.is-active .line{ transform: rotate(30deg); } 


